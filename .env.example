# Copy this file to .env and fill in your own Telegram bot credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Use local video file by default. Put a video in videos/ and set VIDEO_SOURCE=videos/sample.mp4
VIDEO_SOURCE=videos/sample.mp4
YOLO_MODEL=yolo11s.pt
CONFIDENCE_THRESHOLD=0.35
IMAGE_SIZE=960

# Alert only after the object is seen in this many of the recent sampled frames.
PERSISTENCE_HITS=3
PERSISTENCE_WINDOW=5
FRAME_STRIDE=5
ALERT_COOLDOWN_SECONDS=60

# Demo coordinates are synthetic and are never derived from YouTube video pixels.
DEMO_MODE=true
DEMO_CAMERA_ID=CAM-DEMO-01
DEMO_LOCATION_NAME=Simulated Tadoba demo zone
DEMO_LAT_MIN=20.05
DEMO_LAT_MAX=20.35
DEMO_LON_MIN=79.20
DEMO_LON_MAX=79.55

# Ranger exception: suppress alerts for camera IDs listed here while this demo is running.
# Example: RANGER_EXEMPT_CAMERA_IDS=CAM-DEMO-01
RANGER_EXEMPT_CAMERA_IDS=

# Optional: disable Telegram sends while testing detection.
ALERTS_ENABLED=true
